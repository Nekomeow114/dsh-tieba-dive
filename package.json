{
  "name": "dsh-tieba-scroll",
  "version": "1.10.0",
  "description": "DSH 插件 · 刷贴吧：每天替你看几个百度贴吧——读帖挑重点、写日报；自动签到（顺手关注），回帖可选（意图分类 + 客服腔闸门）。支持人设、公开/私人日记、谷时定时跑。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "tieba",
    "baidu",
    "mcp",
    "duty"
  ],
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "prompts",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "dsh": ">=0.1.7-rc.1",
    "node": ">=22"
  },
  "scripts": {
    "test": "node test/smoke.mjs && node test/gates.mjs && node test/apply.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:gates": "node test/gates.mjs",
    "test:apply": "node test/apply.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nekomeow114/dsh-tieba-scroll.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "homepage": "https://github.com/Nekomeow114/dsh-tieba-scroll#readme",
  "bugs": {
    "url": "https://github.com/Nekomeow114/dsh-tieba-scroll/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": "Nekomeow114"
}
