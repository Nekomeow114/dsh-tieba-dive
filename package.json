{
  "name": "dsh-tieba-dive",
  "version": "1.31.2",
  "description": "DSH 插件 · 泡贴吧：读帖挑重点、写日报、自动签到；学习每个吧的语风（风格库），回帖与楼中楼可选（默认关）。支持人设、日记、峰谷定时与只读 MCP。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "tieba",
    "baidu",
    "mcp",
    "duty"
  ],
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "prompts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "mcp-server.mjs"
  ],
  "engines": {
    "dsh": ">=0.1.7-rc.1",
    "node": ">=22"
  },
  "scripts": {
    "test": "node test/smoke.mjs && node test/gates.mjs && node test/apply.mjs && node test/mcp-smoke.mjs && node test/cookie.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:gates": "node test/gates.mjs",
    "test:apply": "node test/apply.mjs",
    "test:mcp": "node test/mcp-smoke.mjs",
    "test:cookie": "node test/cookie.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nekomeow114/dsh-tieba-dive.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "homepage": "https://github.com/Nekomeow114/dsh-tieba-dive#readme",
  "bugs": {
    "url": "https://github.com/Nekomeow114/dsh-tieba-dive/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": "Nekomeow114"
}
