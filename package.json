{
  "name": "dsh-tieba-scroll",
  "version": "0.7.2",
  "description": "DSH 插件 · 刷贴吧：每天替你刷几个百度贴吧，读帖挑值得看的、写日报；可选签到与回帖（默认关，带意图与语气闸门）。支持人设与日记本。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "tieba",
    "baidu",
    "mcp",
    "duty"
  ],
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "prompts",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.1.7-rc.1",
    "node": ">=22"
  },
  "scripts": {
    "test": "node test/smoke.mjs && node test/gates.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:gates": "node test/gates.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nekomeow114/dsh-tieba-scroll.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  }
}
